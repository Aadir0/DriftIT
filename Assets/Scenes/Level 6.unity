  m_Script: {fileID: 11500000, guid: 5f6a1d13dd5524348bc33fb3cc71ff21, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RandomTextOnEnable
  randomTexts:
  - "\u201CWere you moving, or just thinking about moving?\u201D"
  - "\u201CAt this speed, even the snails are getting impatient.\u201D"
  - "\u201CI\u2019ve seen loading screens move faster than you.\u201D"
  - "\u201CSpeed up! That trap has already filed a missing-person report.\u201D"
  tmpText: {fileID: 0}
  legacyText: {fileID: 5130855979554977848}
  avoidImmediateRepeat: 1
