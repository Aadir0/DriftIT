--- !u!114 &8820269110671711736
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 411185069544127225}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f6a1d13dd5524348bc33fb3cc71ff21, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RandomTextOnEnable
  randomTexts:
  - "\u201CYou and that trap are becoming really good friends.\u201D"
  - "\u201CThe trap didn\u2019t even have to try.\u201D"
  - "\u201CDodging is apparently an optional feature.\u201D"
  - "\u201CThat trap saw you coming and started celebrating.\u201D"
  - "\u201CYour greatest enemy isn\u2019t the trap. It\u2019s your reaction time.\u201D"
  - "\u201CYou\u2019ve been here before. You know exactly what happens next.\u201D"
  - "\u201CCongratulations! You found the trap. Again.\u201D"
  - "\u201CMaybe try going around it this time?\u201D"
  - "\u201CThe trap has more wins than you do.\u201D"
  - "\u201CThat wasn\u2019t bad luck. That was a skill issue.\u201D"
  - "\u201CEven the trap is wondering what you\u2019re doing.\u201D"
  - "\u201CAt this rate, the trap deserves the checkpoint.\u201D"
  - "\u201CAt this point, just ask the trap for directions.\u201D"
  tmpText: {fileID: 0}
  legacyText: {fileID: 4198176987429419368}
  avoidImmediateRepeat: 1
